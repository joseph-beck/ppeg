{
  "name": "ppeg-ui",
  "description": "user interface for ppeg",
  "version": "0.1.0",
  "author": {
    "name": "Joseph Beck",
    "email": "joseph.beck.2022@live.rhul.ac.uk"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && vite build && tsc -b",
    "build:wasm": "cd ../ppeg-wasm && wasm-pack build --target web --out-dir ../ppeg-ui/ppeg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "pnpm run build:wasm && vite preview",
    "fmt": "prettier . --check --cache",
    "fmt:fix": "prettier . --write",
    "e2e": "pnpm run build:wasm && playwright test",
    "test": "pnpm run build:wasm && vitest run",
    "test:coverage": "pnpm run build:wasm && vitest run --coverage",
    "test:watch": "pnpm run build:wasm && vitest watch",
    "bundle:analyse": "vite-bundle-visualizer --output dist/stats.html"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource-variable/figtree": "^5.2.10",
    "@tabler/icons-react": "^3.41.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-router": "^1.168.8",
    "@tanstack/react-store": "^0.8.1",
    "@uiw/codemirror-theme-xcode": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.562.0",
    "ppeg-wasm": "link:ppeg",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tanstack/eslint-plugin-query": "^5.95.2",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/router-plugin": "^1.167.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.2"
  }
}
